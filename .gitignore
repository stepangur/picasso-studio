# В репозиторий уезжает только docs/ — тестовая сборка для GitHub Pages.
# Всё остальное внутреннее и публиковаться не должно.
#
# Ведущий «/» обязателен: без него шаблон совпадает на любом уровне
# вложенности и выбрасывает заодно docs/assets, docs/index.html и т. д.

# Планы, сметы, рабочие заметки
/*.md

# Исходный макет и боевая сборка
/picasso-studio.html
/index.html
/preview.html
/assets/
/robots.txt
/sitemap.xml
/site.webmanifest
/.htaccess

# Выгрузки и архивы
/cue-данные/
/*.zip

# Локальное окружение
/.claude/
